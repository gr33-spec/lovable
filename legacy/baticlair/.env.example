# Copie ce fichier en `.env` et complète les valeurs nécessaires.
# Toutes les intégrations externes sont à dégradation gracieuse : sans leur
# clé, BatiClair reste utilisable (le contenu est affiché dans les logs du
# serveur ou la fonctionnalité concernée est désactivée proprement).

# Base de données PostgreSQL (obligatoire).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baticlair?schema=public"

# Connexion par lien magique (Auth.js, étape 5). Génère une valeur avec
# `npx auth secret` ou `openssl rand -base64 32`.
AUTH_SECRET=""

# Analyse IA des devis/factures (étapes 3-4, obligatoire pour /analyser).
ANTHROPIC_API_KEY=""
# Modèle utilisé pour les analyses ("claude-sonnet-4-6" par défaut).
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Envoi d'e-mails via Resend (lien de connexion, demandes de devis, relances).
# Sans clé, le contenu des e-mails est affiché dans les logs du serveur (dev).
# RESEND_API_KEY=""
# EMAIL_FROM="BatiClair <connexion@baticlair.fr>"

# Abonnement Pro (Stripe, étape 6). Sans ces clés, le paiement est désactivé
# (le bouton "Passer au plan Pro" affiche un message d'indisponibilité).
# STRIPE_SECRET_KEY=""
# STRIPE_PRICE_ID=""
# STRIPE_WEBHOOK_SECRET=""

# Demande de devis (étape 7).
# Domaine de réception des réponses fournisseurs (plus-addressing
# demande+<id>@domaine, routé vers /api/inbound-email). Sans cette variable,
# les réponses des fournisseurs arrivent directement dans la boîte mail de
# l'artisan.
# INBOUND_EMAIL_DOMAIN=""
# Nombre de jours entre deux relances automatiques (3 par défaut).
# RELANCE_INTERVAL_JOURS="3"
# Protègent /api/relancer (cron) et /api/inbound-email (webhook e-mail
# entrant) : si définies, l'appel doit fournir l'en-tête
# `Authorization: Bearer <secret>`.
# CRON_SECRET=""
# INBOUND_EMAIL_SECRET=""

# Stockage des pièces jointes des réponses fournisseurs (Supabase Storage,
# étape 7). Sans ces clés, seul le nom du fichier est conservé.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="demandes"
