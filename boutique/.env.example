# ─────────────────────────────────────────────────────────────────────
# La Bohème en Paillettes — variables d'environnement
# Copier en .env.local pour le développement. En production, les saisir
# dans Vercel → Settings → Environment Variables (jamais dans Git).
# ─────────────────────────────────────────────────────────────────────

# Adresse publique du site (sans / final).
SITE_URL=http://localhost:3000

# Base PostgreSQL (Supabase : Project Settings → Database → Connection string,
# mode « Transaction », port 6543).
DATABASE_URL=postgresql://postgres@localhost:5433/boutique
# Certificat de Supabase (contenu PEM) pour vérifier la connexion chiffrée.
# DATABASE_CA_CERT=

# Secret de l'application (au moins 32 caractères aléatoires).
# Générer : openssl rand -base64 48
APP_SECRET=dev-secret-a-remplacer-par-une-valeur-aleatoire-longue

# Paiement : "stripe", ou "fake" (simulateur local, refusé en production).
PAYMENT_PROVIDER=fake
# "test" ou "live" — doit correspondre à la clé. Passage en "live" = volontaire.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiant du compte Stripe officiel (acct_…) : le site refuse de
# fonctionner avec un autre compte.
STRIPE_ACCOUNT_ID=

# Stockage des photos : "local" (développement) ou "supabase".
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mails : "dev" (écrits dans .data/emails) ou "resend".
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="La Bohème en Paillettes <commandes@labohemeenpaillettes.fr>"

# Tâches planifiées (Vercel Cron envoie ce secret).
CRON_SECRET=dev-cron-secret

# Première installation uniquement : jeton pour créer le compte de la
# créatrice sur /admin/installation. À supprimer ensuite.
ADMIN_SETUP_TOKEN=
