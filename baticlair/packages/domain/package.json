{
  "name": "@baticlair/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Noyau métier pur (sans framework ni prestataire) : argent, quantités, unités, offres fournisseurs, moteur de comparaison.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/gen-fiches.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/gen-fiches.mjs && tsc --noEmit",
    "test": "node scripts/gen-fiches.mjs && vitest run",
    "test:watch": "vitest",
    "gen:fiches": "node scripts/gen-fiches.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
