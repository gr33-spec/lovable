{
  "name": "baticlair",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @baticlair/api db:migrate",
    "db:deploy": "pnpm --filter @baticlair/api db:deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "^1.2.2",
      "mysql2@<3.23.1": "^3.23.1",
      "vite@~8.3.0": "^8.3.3",
      "@vitest/mocker@<4.1.12": "^4.1.12",
      "multer@<2.5.0": "^2.5.0",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0"
    }
  }
}
