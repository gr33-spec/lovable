# Copier en `.env` (jamais commité). Tout est validé au démarrage :
# l'API refuse de démarrer si une variable obligatoire manque.

NODE_ENV="development"
PORT=4000
LOG_LEVEL="info"

# PostgreSQL (docker compose up -d fournit cette base).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baticlair_dev"
# Base utilisée par les tests d'intégration (vidée à chaque exécution).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baticlair_test"

# Secret de session, ≥ 32 caractères : openssl rand -base64 32
AUTH_SECRET=""

API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# E-mails transactionnels. Seul l'adapter de développement existe :
# "console" affiche les e-mails dans les logs (liens de vérification inclus).
# Hors développement, l'API refuse de démarrer sans fournisseur réel.
EMAIL_PROVIDER="console"

# Connexion Google / Microsoft (NON CONNECTÉ tant que vide).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
