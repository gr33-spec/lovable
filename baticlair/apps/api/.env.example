# Copier en `.env` (jamais commité). Tout est validé au démarrage :
# l'API refuse de démarrer si une variable obligatoire manque.

NODE_ENV="development"
PORT=4000
LOG_LEVEL="info"

# PostgreSQL (docker compose up -d fournit cette base).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baticlair_dev"
# Base utilisée par les tests d'intégration (vidée à chaque exécution).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baticlair_test"

# Secret de session, ≥ 32 caractères : openssl rand -base64 32
AUTH_SECRET=""

API_PUBLIC_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# E-mails transactionnels. Seul l'adapter de développement existe :
# "console" affiche les e-mails dans les logs (liens de vérification inclus).
# Hors développement, l'API refuse de démarrer sans fournisseur réel.
EMAIL_PROVIDER="console"

# Connexion Google / Microsoft (NON CONNECTÉ tant que vide).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""

# Lot B (16 novembre 2026). Clé des fichiers chiffrés au repos : 32 octets en base64 (openssl rand -base64 32).
# Vide : rien n'est chiffré. Posée par Greg seulement ; à garder aussi hors de Vercel (sans elle, les fichiers sont perdus).
CHIFFREMENT_CLE=
# Place accordée à la base, en Mo (Neon gratuit : 512). Au-delà de 70 %, une alerte part. 0 : pas d'alerte.
BASE_TAILLE_MAX_MO=512
# Ma page Mobiiz (16 novembre 2026) : les photos des pages publiques des entreprises, dans un stockage objet avec CDN
# (jamais la base). En ligne : créer un store Vercel Blob (Storage › Blob) et le relier au projet API, qui reçoit alors
# BLOB_READ_WRITE_TOKEN. Sans jeton : « local » hors production (dossier STOCKAGE_PHOTOS_DOSSIER, servi par l'API),
# « off » en production (l'éditeur dit que l'envoi de photos n'est pas encore ouvert). STOCKAGE_PHOTOS force le choix.
BLOB_READ_WRITE_TOKEN=
STOCKAGE_PHOTOS=
STOCKAGE_PHOTOS_DOSSIER=
# Côté site (projet web) : PHOTOS_BLOB_URL = l'adresse publique du store (« https://<id>.public.blob.vercel-storage.com ») ;
# le site sert les photos sous /photos/… (même domaine, la CSP reste « rien d'ailleurs »).
# Côté site (projet web) : PAGES_ENTREPRISES_INDEXEES=on laisse Google indexer les pages /e/… (à poser en production
# seulement ; le site de test reste « noindex »).
