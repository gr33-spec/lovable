{
  "name": "@baticlair/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API métier (NestJS) : entrée HTTP et, à venir, worker de jobs.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.vercel.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "pnpm --filter @baticlair/domain build && prisma generate && prisma migrate deploy && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@baticlair/domain": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "^3.9.11",
    "better-auth": "1.7.6",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "11.2.6",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.0",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
